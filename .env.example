# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/cdc.db

# SharePoint Configuration
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/CDC
SHAREPOINT_LIBRARY_NAME=DocumentLibrary
SHAREPOINT_CLIENT_ID=your-client-id
SHAREPOINT_CLIENT_SECRET=your-client-secret
SHAREPOINT_TENANT_ID=your-tenant-id

# Service Account (for SharePoint access)
SERVICE_ACCOUNT_USERNAME=service@yourcompany.com
SERVICE_ACCOUNT_PASSWORD=your-service-account-password

# File Upload Configuration
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.pdf,.doc,.docx

# Security
JWT_SECRET=your-jwt-secret-key-change-this
SESSION_SECRET=your-session-secret-change-this
